# ========================================================
# Arachne - Self-Hosted Environment Configuration
# Repository: https://github.com/DeepxkJadhav/Arachne
# ========================================================

# Port configuration
PORT=3002
INTERNAL_PORT=3002

# Concurrency & Performance
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# Database & Queue Configuration
USE_DB_AUTHENTICATION=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379

# Microservices
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# Optional AI / LLM Integration (OpenAI, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=

# Search Engines (e.g. SearXNG)
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# Proxy Configuration (Optional, for anti-bot / rotation)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Security & Management
BULL_AUTH_KEY=
TEST_API_KEY=
SLACK_WEBHOOK_URL=
LOGGING_LEVEL=info
